{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "inline",
        "data": <%= json Enum.map_join(@rows, "\n", &Jason.encode!/1) %>
      },
      "inputFormat": {"type": "json"},
      "appendToExisting": false
    },
    "tuningConfig": {
      "type": "index_parallel",
      "partitionsSpec": {"type": "dynamic"},
      "maxParseExceptions": <%= @max_parse_exceptions %>
    },
    "dataSchema": <%= data_schema Ecto.Adapters.Druid.PageViews,
                        data_source: "ecto_druid_tasks_test",
                        segment_granularity: "DAY",
                        intervals: [@interval] %>
  }
}
